{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DJ Music Manager",
  "version": "0.1.0",
  "identifier": "com.djmusicmanager.app",
  "build": {
    "beforeDevCommand": "npm run start --prefix frontend",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --prefix frontend",
    "frontendDist": "../frontend/dist/tauri-app/browser"
  },
  "app": {
    "windows": [
      {
        "title": "DJ Music Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
